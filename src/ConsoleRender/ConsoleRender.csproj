<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Runs the .editorconfig style rules during the build, so a violation fails CI
         instead of only showing up as an IDE squiggle. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Self-explanatory members (color constants, enum values, simple accessors) carry no doc comment. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ConsoleRender</PackageId>
    <Version>0.5.0</Version>
    <Authors>ConsoleRender Contributors</Authors>
    <Description>A double-buffered TUI framework for .NET console applications: GUI-like controls (input fields, output logs, menus, checkboxes, radio groups, dialogs and frames), anchor-based layout that rescales with the terminal, slash commands with tab completion, global key bindings, text animations, and clipboard support for both text and images.</Description>
    <PackageTags>console;terminal;tui;ui;ansi;framework</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 ConsoleRender Contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hopp1395/console-render</RepositoryUrl>
    <PackageProjectUrl>https://github.com/hopp1395/console-render</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SourceLink ships with the SDK; these let a consumer step into the package's sources. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- A CI build records source paths as repository-relative, which makes it reproducible. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Aktiviert die standardmäßigen .NET-Analysatoren (CAxxxx) zusätzlich zu den Codestil-Regeln (IDExxxx). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
